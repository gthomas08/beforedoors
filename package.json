{
  "name": "my-better-t-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r --if-present build",
    "check-types": "pnpm -r check-types",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter @my-better-t-app/backend dev",
    "dev:setup": "pnpm --filter @my-better-t-app/backend dev:setup",
    "check": "oxlint && oxfmt --write",
    "fix:tailwind": "oxlint --fix --fix-suggestions apps/web/src && oxfmt --write apps/web/src"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-plugin-react-doctor": "^0.9.14",
    "oxlint-tailwindcss": "^1.12.0",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.25.0"
}
